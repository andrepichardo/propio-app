# ---------------------------------------------------------------------------
# Propio — environment variables
# Copy this file to `.env` and fill in the values.
# All server-only secrets MUST NOT be prefixed with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# --- Database (PostgreSQL) -------------------------------------------------
# Pooled connection used by the app at runtime.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/propio?schema=public"
# Direct (non-pooled) connection used by Prisma Migrate.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/propio?schema=public"

# --- Auth.js (NextAuth v5) -------------------------------------------------
# Generate with: `openssl rand -base64 32`
AUTH_SECRET="replace-me-with-a-long-random-string"
# Only needed when NOT running on Vercel (e.g. local dev / self-host).
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Google OAuth
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# GitHub OAuth
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# --- Resend (transactional email) ------------------------------------------
# Prod sends from the verified domain (no-reply@usepropio.com). For local dev
# keep onboarding@resend.dev: it only delivers to the Resend account owner, so
# test runs can never reach a real tenant.
RESEND_API_KEY=""
EMAIL_FROM="Propio <onboarding@resend.dev>"

# --- Supabase Storage ------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=""
# The service role key is server-only. Never expose it to the client.
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="propio"

# --- Cron ------------------------------------------------------------------
# Shared secret for /api/cron/* endpoints (payment/contract reminders).
# Vercel Cron sends it automatically; external schedulers must pass
# `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=""

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Propio"
