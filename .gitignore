# env files
.env
.env*.local
# Reference copy of the PROD credentials, used only by the manual
# schema commands. Deliberately NOT named .env.production: Next loads
# .env.[mode] automatically, so that name made `next start` talk to the
# production database from a local machine.
.env.prod.reference

