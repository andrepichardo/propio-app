// ---------------------------------------------------------------------------
// Propio — Prisma schema
//
// Design principles:
//   • Multi-tenant by ownership. Every tenant-scoped row carries `ownerId`
//     pointing at the owning User. Repositories ALWAYS filter by it.
//   • Soft deletes. Domain rows carry `deletedAt`; queries exclude them.
//   • Audit fields: createdAt / updatedAt / deletedAt on every domain model.
//   • Money is stored as Decimal(12,2) — never floats.
//   • Explicit onDelete rules; indexes on every foreign key + hot filters.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ===========================================================================
// AUTH (Auth.js / NextAuth) — the User is also the tenant root.
// ===========================================================================

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  hashedPassword String? // null for pure-OAuth accounts

  role     UserRole @default(OWNER)
  locale   String   @default("en")
  currency String   @default("USD") // ISO 4217, used for money formatting

  // UI date display style: MEDIUM | DMY | MDY | LONG | ISO (see date-format.ts).
  dateFormat String @default("MEDIUM")

  // Handwritten signature image (storage URL) stamped on receipt PDFs.
  signatureUrl String?

  // Reminder preferences consumed by the daily notification scheduler. Lead
  // days = how many days ahead the reminder opens; the toggles mute a type.
  notifyContractExpiring   Boolean @default(true)
  contractExpiringLeadDays Int     @default(30)
  notifyPaymentUpcoming    Boolean @default(true)
  paymentUpcomingLeadDays  Int     @default(3)
  notifyPaymentLate        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Auth.js relations
  accounts Account[]
  sessions Session[]

  // Tenant-owned data (all cascade: deleting an owner removes their world)
  properties         Property[]
  tenants            Tenant[]
  contracts          Contract[]
  payments           Payment[]
  receipts           Receipt[]
  statements         Statement[]
  expenses           Expense[]
  documents          Document[]
  notifications      Notification[]
  activities         Activity[]
  depositSettlements DepositSettlement[]

  @@index([email])
  @@map("users")
}

enum UserRole {
  OWNER
  ADMIN // reserved for internal/staff usage
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ===========================================================================
// PROPERTIES
// ===========================================================================

model Property {
  id      String @id @default(cuid())
  ownerId String

  name        String
  description String?        @db.Text
  type        PropertyType   @default(TRADITIONAL_RENTAL)
  status      PropertyStatus @default(AVAILABLE)

  // Address
  addressLine String?
  city        String?
  state       String?
  postalCode  String?
  country     String? // ISO 3166-1 alpha-2

  // Denormalised financials help the dashboard avoid N+1 aggregation.
  bedrooms  Int?
  bathrooms Int?
  areaSqm   Decimal? @db.Decimal(10, 2)

  // What the unit comes with. Mutually exclusive, hence an enum rather than
  // booleans: a unit is empty, appliances-only, or fully furnished.
  furnishing    FurnishingType @default(UNFURNISHED)
  parkingSpaces Int?

  // Amenities worth recording for a DR rental. Additive booleans — more can
  // be appended later without touching existing rows.
  petsAllowed        Boolean @default(false)
  hasPowerBackup     Boolean @default(false) // planta eléctrica / inversor
  hasWaterTank       Boolean @default(false) // cisterna / tinaco
  hasAirConditioning Boolean @default(false)

  coverImageUrl String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  photos             PropertyPhoto[]
  contracts          Contract[]
  payments           Payment[]
  expenses           Expense[]
  documents          Document[]
  receipts           Receipt[]
  statements         Statement[]
  depositSettlements DepositSettlement[]

  @@index([ownerId])
  @@index([ownerId, status])
  @@index([ownerId, type])
  @@index([ownerId, deletedAt])
  @@map("properties")
}

enum PropertyType {
  TRADITIONAL_RENTAL
  VACATION_RENTAL
  PERSONAL
  COMMERCIAL // future
}

enum PropertyStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

/**
 * What the unit includes. APPLIANCES_ONLY is DR's "línea blanca": fridge,
 * stove and washer, but no furniture.
 */
enum FurnishingType {
  UNFURNISHED
  APPLIANCES_ONLY
  FURNISHED
}

model PropertyPhoto {
  id         String  @id @default(cuid())
  propertyId String
  url        String
  storageKey String // path in the storage bucket, for deletion/migration
  caption    String?
  position   Int     @default(0)

  createdAt DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("property_photos")
}

// ===========================================================================
// TENANTS (the people renting — distinct from the SaaS "tenant"/owner)
// ===========================================================================

model Tenant {
  id      String @id @default(cuid())
  ownerId String

  firstName      String
  lastName       String
  email          String?
  phone          String?
  identification String? // national ID / passport number
  avatarUrl      String?

  emergencyName     String?
  emergencyPhone    String?
  emergencyRelation String?

  notes String? @db.Text

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  contracts          Contract[]
  payments           Payment[]
  documents          Document[]
  receipts           Receipt[]
  statements         Statement[]
  depositSettlements DepositSettlement[]

  @@index([ownerId])
  @@index([ownerId, deletedAt])
  @@index([ownerId, lastName])
  @@map("tenants")
}

// ===========================================================================
// CONTRACTS
// ===========================================================================

model Contract {
  id         String @id @default(cuid())
  ownerId    String
  propertyId String
  tenantId   String

  startDate           DateTime
  endDate             DateTime? // null = open-ended
  monthlyRent         Decimal   @db.Decimal(12, 2)
  currency            String    @default("USD")
  dueDay              Int       @default(1) // day of month rent is due (1-31)
  securityDeposit     Decimal   @default(0) @db.Decimal(12, 2)
  maintenanceIncluded Boolean   @default(false)

  status         ContractStatus @default(ACTIVE)
  contractPdfUrl String?
  notes          String?        @db.Text

  /**
   * Renewal chain. A renewal is a NEW contract (immutable terms per period)
   * linked back to the one it replaces, so rent history is never overwritten.
   * Unique => a contract has at most one successor, keeping the chain linear.
   * The security deposit follows the chain instead of being re-collected.
   */
  renewedFromId String?   @unique
  renewedFrom   Contract? @relation("ContractRenewal", fields: [renewedFromId], references: [id], onDelete: SetNull)
  renewedTo     Contract? @relation("ContractRenewal")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  owner    User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  payments           Payment[]
  receipts           Receipt[]
  statements         Statement[]
  depositSettlements DepositSettlement[]

  @@index([ownerId])
  @@index([ownerId, status])
  @@index([propertyId])
  @@index([tenantId])
  @@index([ownerId, endDate])
  @@index([ownerId, deletedAt])
  @@map("contracts")
}

enum ContractStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

// ===========================================================================
// PAYMENTS
// ===========================================================================

model Payment {
  id         String @id @default(cuid())
  ownerId    String
  contractId String
  propertyId String
  tenantId   String

  amount    Decimal       @db.Decimal(12, 2)
  currency  String        @default("USD")
  method    PaymentMethod @default(TRANSFER)
  type      PaymentType   @default(RENT) // DEPOSIT is a liability, excluded from income
  status    PaymentStatus @default(COMPLETED)
  reference String? // bank ref / check number
  concept   String? // "Rent — March 2026"
  proofUrl  String? // uploaded proof of payment (transfer screenshot / bank receipt)

  // The rent period this payment settles (first day of the month).
  periodStart DateTime?
  periodEnd   DateTime?
  paidAt      DateTime  @default(now())

  // Marks the rent period as fully settled even when `amount` < the contract's
  // monthly rent (e.g. an agreed discount). Keeps it out of "upcoming payments"
  // and leaves no balance. Ignored for DEPOSIT payments.
  settlesPeriod Boolean @default(false)

  notes String? @db.Text

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  owner    User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  contract Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  receipt Receipt?

  @@index([ownerId])
  @@index([ownerId, paidAt])
  @@index([ownerId, status])
  @@index([contractId])
  @@index([propertyId])
  @@index([tenantId])
  @@index([ownerId, periodStart])
  @@map("payments")
}

enum PaymentMethod {
  CASH
  TRANSFER
  CARD
  CHECK
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentType {
  RENT
  DEPOSIT
}

// ===========================================================================
// DEPOSIT SETTLEMENTS
// ===========================================================================

/**
 * Closing the deposit cycle for a contract: what went back to the tenant and
 * what the owner kept (e.g. to cover damages). One settlement per contract.
 * Accounting: `amountReturned` is neither income nor expense (it is the
 * tenant's own money going back), while `amountRetained` becomes income on
 * `settledAt`. Invariant enforced in the service:
 * amountReturned + amountRetained == depositHeld
 */
model DepositSettlement {
  id         String @id @default(cuid())
  ownerId    String
  /**
   * NOT unique: a voided settlement keeps its row (soft delete), so the
   * "one settlement per contract" rule is enforced in the service against
   * live rows only — a unique constraint here would block re-settling after
   * a correction.
   */
  contractId String
  propertyId String
  tenantId   String

  /**
   * Snapshot of the deposit collected for this contract at settlement time.
   */
  depositHeld    Decimal @db.Decimal(12, 2)
  amountReturned Decimal @db.Decimal(12, 2)
  amountRetained Decimal @db.Decimal(12, 2)
  currency       String  @default("USD")

  /**
   * Why the owner kept part of it (damages, cleaning, unpaid rent…).
   */
  reason    String?  @db.Text
  settledAt DateTime

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /**
   * Voided correction: excluded from balances so the deposit is held again.
   */
  deletedAt DateTime?

  owner    User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  contract Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([ownerId])
  @@index([ownerId, settledAt])
  @@index([contractId])
  @@map("deposit_settlements")
}

// ===========================================================================
// RECEIPTS
// ===========================================================================

model Receipt {
  id         String @id @default(cuid())
  ownerId    String
  paymentId  String @unique
  contractId String
  propertyId String
  tenantId   String

  // Human-friendly sequential number, unique per owner (e.g. "REC-2026-0001").
  number       String
  concept      String
  amount       Decimal @db.Decimal(12, 2)
  currency     String  @default("USD")
  balanceAfter Decimal @default(0) @db.Decimal(12, 2)

  issuedAt DateTime @default(now())
  pdfUrl   String? // cached rendered PDF in storage

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner    User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  payment  Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  contract Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([ownerId, number])
  @@index([ownerId])
  @@index([contractId])
  @@index([tenantId])
  @@map("receipts")
}

// ===========================================================================
// MONTHLY STATEMENTS
// ===========================================================================

model Statement {
  id         String @id @default(cuid())
  ownerId    String
  contractId String
  propertyId String
  tenantId   String

  number      String
  periodStart DateTime
  periodEnd   DateTime

  totalCharged Decimal   @db.Decimal(12, 2)
  totalPaid    Decimal   @db.Decimal(12, 2)
  outstanding  Decimal   @db.Decimal(12, 2)
  nextDueDate  DateTime?
  currency     String    @default("USD")

  pdfUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner    User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  contract Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([ownerId, number])
  @@index([ownerId])
  @@index([contractId])
  @@index([ownerId, periodStart])
  @@map("statements")
}

// ===========================================================================
// EXPENSES
// ===========================================================================

model Expense {
  id         String  @id @default(cuid())
  ownerId    String
  propertyId String? // optional: some expenses are portfolio-wide

  category    ExpenseCategory @default(OTHER)
  description String
  amount      Decimal         @db.Decimal(12, 2)
  currency    String          @default("USD")
  incurredAt  DateTime        @default(now())
  vendor      String?
  notes       String?         @db.Text
  invoiceUrl  String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  owner    User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([ownerId, incurredAt])
  @@index([ownerId, category])
  @@index([propertyId])
  @@index([ownerId, deletedAt])
  @@map("expenses")
}

enum ExpenseCategory {
  MAINTENANCE
  CONDOMINIUM
  CLEANING
  REPAIRS
  PAINTING
  FURNITURE
  UTILITIES
  TAXES
  INSURANCE
  OTHER
}

// ===========================================================================
// DOCUMENTS
// ===========================================================================

model Document {
  id         String  @id @default(cuid())
  ownerId    String
  propertyId String?
  tenantId   String?

  name       String
  type       DocumentType @default(OTHER)
  url        String
  storageKey String
  mimeType   String?
  sizeBytes  Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  owner    User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant   Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([propertyId])
  @@index([tenantId])
  @@index([ownerId, type])
  @@map("documents")
}

enum DocumentType {
  CONTRACT
  PHOTO
  INVOICE
  ID
  OTHER
}

// ===========================================================================
// NOTIFICATIONS
// ===========================================================================

model Notification {
  id      String @id @default(cuid())
  ownerId String

  type       NotificationType
  title      String
  body       String?          @db.Text
  // `{ key, params }` for locale-aware rendering (title/body are the English
  // fallback for legacy rows), mirroring the Activity feed.
  metadata   Json?
  // Loose reference to the entity that triggered the notification.
  entityType String?
  entityId   String?
  actionUrl  String?

  readAt DateTime?
  dueAt  DateTime? // when the reminder becomes relevant

  createdAt DateTime @default(now())

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([ownerId, readAt])
  @@index([ownerId, dueAt])
  @@map("notifications")
}

enum NotificationType {
  PAYMENT_UPCOMING
  PAYMENT_LATE
  CONTRACT_EXPIRING
  MAINTENANCE_REMINDER
  SYSTEM
}

// ===========================================================================
// ACTIVITY LOG (audit trail powering "Recent Activity")
// ===========================================================================

model Activity {
  id      String @id @default(cuid())
  ownerId String

  action     ActivityAction
  entityType String // "Property" | "Payment" | ...
  entityId   String
  summary    String // "Registered payment of $1,200 for Apt 4B"
  metadata   Json?

  createdAt DateTime @default(now())

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([ownerId, createdAt])
  @@map("activities")
}

enum ActivityAction {
  CREATED
  UPDATED
  DELETED
  PAYMENT_REGISTERED
  RECEIPT_GENERATED
  STATEMENT_GENERATED
}
